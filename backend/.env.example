PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/visionboard
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15d
CLIENT_ORIGIN=http://localhost:3001

# Preferred Groq setup for AI summaries.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Optional generic fallback names if you want another OpenAI-compatible provider.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
